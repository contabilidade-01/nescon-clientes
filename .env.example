# Copiar para .env na raiz (não commitar o .env real).
# No Easypanel: definir as mesmas chaves nas variáveis de ambiente do serviço Compose.
#
# Credenciais de login (admin e empresas): ver anotações locais de acessos (fora do repo).

# Obrigatório em produção — mesma palavra-passe para Postgres e API (utilizador rhapp).
# Se mudares depois do primeiro deploy, ver db/fix-rhapp-password.sql
DB_PASSWORD=defina_uma_senha_forte

# Obrigatório em produção — string longa e aleatória (ex.: openssl rand -hex 32)
JWT_SECRET=defina_um_segredo_jwt_longo

# Obrigatório em hospedagem só com front estático (ex.: preview Lovable): URL completo da API Node, com /api no fim.
# Se ficar vazio, o browser chama /api no MESMO domínio do site — em previews sem backend isso devolve HTML e o login falha.
# Ex.: https://api.teudominio.com/api
VITE_API_URL=

# Só desenvolvimento (Vite): para onde encaminhar /api (API Node local). Opcional.
# VITE_PROXY_API_TARGET=http://127.0.0.1:3001

# URL pública do front (API): usada nos links de recuperação de senha e nos links de
# entrega enviados por WhatsApp (PUBLIC_APP_URL/entrega/{token}). Sem / no fim.
# Ex.: https://app.seudominio.com
PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Alertas de vencimento pelo WhatsApp (uazapi).
#
# As credenciais são as MESMAS do sistema de guias — é a mesma instância e o mesmo
# número. Peque-as no painel https://free.uazapi.com (a instância precisa estar
# "connected"; se o QR caiu, o token continua válido mas nada é entregue).
UAZAPI_SUBDOMAIN=
UAZAPI_TOKEN=

# Ligar o envio automático, a hora do disparo e o CNPJ do escritório NÃO são variáveis:
# ficam na tela (Alertas -> Configuração, gravadas em app_settings). Ambiente é para o
# que o app precisa saber antes de existir — senha, token, URL pública. O padrão continua
# sendo NÃO enviar: o interruptor nasce desligado.
#
# Quem recebe o alerta também é escolha da tela: a previsão tem seleção por empresa. Era
# o papel da antiga ALERTAS_CNPJ_PERMITIDOS, removida — configurar no ambiente quem
# recebe mensagem cobrava redeploy e falhava calado quando a variável não era repassada
# pelo compose.

# Anti-bloqueio do número: pausa entre dois envios e teto por hora. Os padrões vieram
# do sistema de guias, onde já rodaram em produção.
# ALERTAS_THROTTLE_S=0.6
# ALERTAS_MAX_POR_HORA=180
# "digitando…" no celular do cliente antes da mensagem chegar (ms). 0 desliga.
# ALERTAS_DELAY_MS=1200
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Upload de documentos com reconhecimento de CNPJ.
#
# CNPJ do escritório: a fonte agora é a tela. Isto fica só como plano B para instalação
# que já tinha a variável antes da tela existir.
ESCRITORIO_CNPJ=

# Fallback de IA para ler o PDF quando o parser determinístico não acha o CNPJ.
# Desligado por padrão (a chave `ai_parsing` em app_settings, ligada na tela). Sem
# chave aqui, a opção nem pode ser ligada.
LOVABLE_API_KEY=
# IA_PDF_BASE_URL=https://ai.gateway.lovable.dev/v1
# IA_PDF_MODELO=google/gemini-3-flash-preview
# IA_PDF_TIMEOUT_MS=45000

# Varredura de arquivos órfãos no volume de uploads (análise abandonada, gravação que
# falhou). Só remove o que nenhuma linha do banco referencia E já passou do TTL.
# UPLOADS_TTL_HORAS=48
# UPLOADS_LIMPEZA_INTERVALO_H=12
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Backup diário do banco.
#
# O banco é o ÚNICO dado que não volta sozinho: os PDFs quase todos descem do G-Click de
# novo, mas decisões sobre obrigações, consentimentos LGPD, preferências do cliente e
# histórico de envio não existem em outro lugar.
#
# Esta senha cifra o arquivo (AES-256-GCM) antes de ele sair daqui. O dump carrega CPF,
# salário e telefone de terceiros — mandá-lo em claro por e-mail ou WhatsApp seria
# incoerente com o consentimento LGPD que o portal pede na entrada.
#
# GUARDE-A FORA DO SERVIDOR. Sem ela o backup é um arquivo inútil, e o dia em que você
# precisar dele é justamente o dia em que o servidor não existe mais.
# Mínimo 12 caracteres. Gerar: openssl rand -base64 24
BACKUP_SENHA=

# Ligar, hora, e-mail de destino e WhatsApp do resumo ficam na TELA
# (Sincronização -> Backup do banco), não aqui.
# ---------------------------------------------------------------------------

# Chave de serviço partilhada com o sistema de guias (rotas /api/fiscal/*: release,
# sync-companies, access-stats). Gerar com: openssl rand -hex 32
# A MESMA string vai no PORTAL_INGEST_KEY do sistema de guias.
# Vazia = rotas /api/fiscal/* DESLIGADAS (503).
INGEST_API_KEY=

# Credenciais da API do G-Click (Omie). O portal puxa os documentos direto de lá — são
# as MESMAS credenciais usadas no sistema de guias. Sem elas, o portal não traz documentos.
GCLICK_CLIENT_ID=
GCLICK_CLIENT_SECRET=
# Quantos meses de histórico puxar (padrão 6) e intervalo do agendador em horas
# (0 = desligado, só sincroniza sob demanda / manualmente).
GCLICK_SYNC_MESES=6
GCLICK_SYNC_INTERVAL_H=6
# 1ª carga automática ao subir, só se o portal ainda estiver vazio (false desliga).
GCLICK_SYNC_ON_BOOT=true
# Cliente novo no G-Click só vira alerta de cadastro se estiver ATIVO (padrão).
# `false` alerta também sobre clientes que já nascem desativados.
# Não confundir com o espelho: ele SEMPRE traz todo mundo — sem os desativados não
# haveria como perceber que alguém foi desativado.
GCLICK_ALERTA_SO_ATIVOS=true

# Painel de licenças: quantos dias antes do vencimento uma licença entra em "a vencer"
# (padrão 60, aceita 1 a 365). Não muda nada na base — o estado é sempre calculado.
LICENSE_WARN_DAYS=60

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
